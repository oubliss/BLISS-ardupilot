<?xml version="1.0"?>

<model>
  <name>CopterSonde</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <description>
    CopterSonde (BLISS) for the CopterSonde Gazebo simulator: the ArduPilot Iris
    (iris_with_ardupilot) with the CopterSondePlugin for the atmosphere, wind and battery.
  </description>
  <depend>
    <model>
      <uri>model://iris_with_standoffs</uri>
      <version>1.0</version>
    </model>
  </depend>
</model>
