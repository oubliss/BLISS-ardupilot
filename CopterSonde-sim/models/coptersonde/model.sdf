<?xml version='1.0'?>
<sdf version="1.9">
  <model name="coptersonde">
    <!--
      CopterSonde for the CopterSonde Gazebo simulator (CopterSonde-sim/README.md).
      The airframe is the ArduPilot Iris (iris_with_ardupilot). The CopterSondePlugin adds the
      air: the atmosphere at the vehicle for the iMet and HYT271 simulators in SITL, the wind force
      that the wind-vane estimator measures, and the battery. It also makes the rotors propellers,
      in place of the Iris's LiftDrag blades, which windmill in a 5 m/s descent.
    -->
    <include>
      <uri>model://iris_with_standoffs</uri>
    </include>

    <!-- sensor scoop at the nose (appearance only) -->
    <link name="sensor_scoop">
      <pose>0.16 0 0.215 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-7</ixx><iyy>1e-7</iyy><izz>1e-7</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="scoop">
        <geometry><cylinder><radius>0.035</radius><length>0.16</length></cylinder></geometry>
        <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual>
      <visual name="intake">
        <pose>0 0 0.082 0 0 0</pose>
        <geometry><cylinder><radius>0.03</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material>
      </visual>
    </link>
    <joint name="sensor_scoop_joint" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>sensor_scoop</child>
    </joint>


    <!-- plugins -->
    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>




    <plugin filename="gz-sim-apply-joint-force-system"
      name="gz::sim::systems::ApplyJointForce">
      <joint_name>iris_with_standoffs::rotor_0_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system"
      name="gz::sim::systems::ApplyJointForce">
      <joint_name>iris_with_standoffs::rotor_1_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system"
      name="gz::sim::systems::ApplyJointForce">
      <joint_name>iris_with_standoffs::rotor_2_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system"
      name="gz::sim::systems::ApplyJointForce">
      <joint_name>iris_with_standoffs::rotor_3_joint</joint_name>
    </plugin>

    <plugin name="ArduPilotPlugin"
      filename="ArduPilotPlugin">
      <!-- Port settings -->
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <no_time_sync>1</no_time_sync>
      <have_32_channels>0</have_32_channels>

      <!-- wind, battery and atmosphere from the CopterSondePlugin -->
      <json_extra_topic>/model/coptersonde/coptersonde</json_extra_topic>

      <!-- Frame conventions
        Require by ArduPilot: change model and gazebo from XYZ to XY-Z coordinates
      -->
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>

      <!-- Sensors -->
      <imuName>iris_with_standoffs::imu_link::imu_sensor</imuName>

      <!--
          incoming control command [0, 1]
          so offset it by 0 to get [0, 1]
          and divide max target by 1.
          offset = 0
          multiplier = 838 max rpm / 1 = 838
        -->
      <control channel="0">
        <jointName>iris_with_standoffs::rotor_0_joint</jointName>
        <useForce>1</useForce>
        <multiplier>838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>

      <control channel="1">
        <jointName>iris_with_standoffs::rotor_1_joint</jointName>
        <useForce>1</useForce>
        <multiplier>838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>

      <control channel="2">
        <jointName>iris_with_standoffs::rotor_2_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>

      <control channel="3">
        <jointName>iris_with_standoffs::rotor_3_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>

    </plugin>

    <!--
      The air around the CopterSonde (see ardupilot_gazebo include/CopterSondePlugin.hh).
      Environment variables override: CS_START_HOUR, CS_CYCLE_HOURS, CS_ATMOSPHERE, CS_TRUTH_LOG.
    -->
    <plugin name="CopterSondePlugin"
      filename="CopterSondePlugin">
      <profile>atmosphere/norman_pbl.csv</profile>
      <start_hour>9</start_hour>
      <cycle_hours>24</cycle_hours>
      <link_name>iris_with_standoffs::base_link</link_name>
      <rotor_joint_prefix>rotor_</rotor_joint_prefix>
      <!-- the real CopterSonde's wind-vane calibration (USR_WV_WSA, USR_WV_WSB) -->
      <wind_vane_a>39.3</wind_vane_a>
      <wind_vane_b>2.1</wind_vane_b>
      <calibration_density>1.13</calibration_density>
      <vertical_drag_area>0.08</vertical_drag_area>
      <!-- propellers: hover at 450 rad/s (1.75 kg), thrust to weight 3.5 at 838 rad/s -->
      <rotor_thrust_coefficient>2.12e-5</rotor_thrust_coefficient>
      <rotor_moment_ratio>0.016</rotor_moment_ratio>
      <rotor_radius>0.12</rotor_radius>
      <rotor_inflow>1.0</rotor_inflow>
      <turbulence>1</turbulence>
      <!--
        6S 9 Ah LiPo. CSWX flights: 20-21 A in hover, 24-28 A climbing at 4.4-4.9 m/s, 15-18 A
        descending; the induced velocity is fitted to them (here 21.5, 28.1 and 15.7 A at 5 m/s).
      -->
      <battery_cells>6</battery_cells>
      <battery_capacity>9.0</battery_capacity>
      <battery_resistance>0.03</battery_resistance>
      <hover_current>20</hover_current>
      <hover_rotor_speed>450</hover_rotor_speed>
      <hover_induced_velocity>8.0</hover_induced_velocity>
      <profile_power>0.3</profile_power>
      <idle_current>0.8</idle_current>
      <publish_rate>100</publish_rate>
    </plugin>

  </model>
</sdf>
